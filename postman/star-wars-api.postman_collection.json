    {
      "name": "4 POST valid character",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Has an id\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a(\"number\");",
              "    pm.collectionVariables.set(\"newId\", body.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/characters",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "characters"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Obi-Wan Kenobi\",\n  \"role\": \"Jedi\",\n  \"planet\": \"Stewjon\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
