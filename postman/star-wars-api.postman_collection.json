{
  "info": {
    "name": "Star Wars API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "newId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 GET all characters",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns a list\", () => {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/characters",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "characters"
          ]
        }
      }
    },
    {
      "name": "2 GET existing character",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Is Luke\", () => {",
              "    pm.expect(pm.response.json().id).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/characters/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "characters",
            "1"
          ]
        }
      }
    },
